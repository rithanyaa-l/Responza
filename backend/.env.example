# Copy to backend/.env to override the defaults. All values are optional.

# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=scrum_attendance

# Sign-in
SESSION_HOURS=12
# set to true when the site is served over HTTPS
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
MIN_PASSWORD_LENGTH=6

# First admin, created only when there are no users yet (defaults come from seed/admin.json)
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_EMAIL=

# Largest request body accepted, in bytes
MAX_BODY_BYTES=2097152

# Folder with the frontend files (default: ../frontend)
# FRONTEND_DIR=
